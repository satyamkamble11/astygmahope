# =============================================================================
# Astygma Hope Clinic — Backend Environment Variables (Render)
# =============================================================================

# Port for the Express server. Render sets this automatically (PORT env var).
PORT=3000

# PostgreSQL connection string for the Supabase database.
# Format: postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
# This is the SAME connection string used in scripts/deploy-db.cjs
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.gcqawwsopkbsednwzgph.supabase.co:5432/postgres

# Secret used to sign JWT tokens. Generate a strong random value.
# In PowerShell:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_SECRET=change_me_to_a_long_random_string

# JWT token lifetime (e.g. 7d, 1d, 12h)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS).
# This is your Cloudflare Pages URL (and localhost for dev).
CLIENT_URL=http://localhost:3000,https://your-project.pages.dev
